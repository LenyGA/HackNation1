# Reverse proxy in front of the app (plan M8.1/M8.2).
# No access log is configured, and the remaining (error) logs have the client address and headers removed,
# so no IP addresses are stored (CLAUDE.md rule 10). With "admin off", apply config changes by restarting
# the container (`docker compose restart caddy`), not `caddy reload`.
{
	admin off
	log default {
		format filter {
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				remote_ip delete
				client_ip delete
			}
		}
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		# The report page prints through a hidden same-origin iframe, so same-origin framing must stay allowed.
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Map tiles come from OpenStreetMap and the Geoportal (GUGiK) WMS services (KIEG redirects every tile to
		# integracja01/02.gugik.gov.pl, hence the wildcard); MapLibre runs in a blob/self worker
		# and sets inline styles. Everything else is same-origin.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org https://mapy.geoportal.gov.pl https://*.gugik.gov.pl; connect-src 'self' https://tile.openstreetmap.org https://mapy.geoportal.gov.pl https://*.gugik.gov.pl; worker-src 'self' blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		-Server
	}

	# Hashed build assets never change. Everything else (index.html above all) is revalidated on every visit,
	# so after a redeploy no browser keeps an old page pointing at assets that no longer exist.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@revalidate not path /assets/*
	header @revalidate Cache-Control "no-cache"

	request_body {
		max_size 64KB
	}

	# X-Forwarded-For is overwritten with the real peer address (never passed through from the client): the
	# app trusts it for per-client rate limiting. Port 8000 is not published outside the compose network.
	reverse_proxy app:8000 {
		header_up X-Forwarded-For {remote_host}
	}
}
