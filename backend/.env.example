# No API keys are required. All values below are optional overrides.
# RSW_CACHE_DIR=.cache
# RSW_DB_PATH=.cache/reports.sqlite3
# RSW_CORS_ORIGINS=["http://localhost:5173"]
# RSW_MAX_CONCURRENT_ANALYSES=4
# Per-client limits (hits per window, window in seconds):
# RSW_RATE_LIMIT_ANALYSES=30
# RSW_RATE_LIMIT_ANALYSES_WINDOW_S=600
# RSW_RATE_LIMIT_ANALYSES_BURST=10
# RSW_RATE_LIMIT_ANALYSES_BURST_WINDOW_S=60
# RSW_RATE_LIMIT_PARCELS=120
# RSW_RATE_LIMIT_PARCELS_WINDOW_S=60
