{#- G9: one sentence per retention method (reason) — the status itself is computed in recommendations/retention_methods.py. -#}
{% set p = m.params %}
{% set farm = farm_n|default(1) > 1 %}
{% set main_g = ' głównej' if farm else '' %}
{% set fw = (' ' ~ (farm_n|m3_where)) if farm else '' %}
{% macro pct(v) %}{% if v >= 100 %}całą{% elif v < 1 %}mniej niż 1 %{% else %}ok. {{ v|num }} %{% endif %}{% endmacro %}
{% macro where(d) %}{% if d < 10 %}przy granicy działki{% else %}ok. {{ d|num(10) }} m od działki{% endif %}{% endmacro %}
{% if m.id == 'pond' %}
{% if m.reason == 'no_terrain' %}Nie mamy danych o ukształtowaniu terenu, więc nie wiemy, czy na działce jest zagłębienie na staw.
{% elif m.reason == 'no_depression' %}Na działce nie ma zagłębienia, w którym zbiera się woda — staw trzeba by wykopać od zera.
{% elif m.reason == 'small' %}Największe zagłębienie zatrzyma tylko ok. {{ p.volume_m3|num }} m³ wody (mniej niż {{ p.min_volume_m3|num }} m³) — za mało na staw.
{% else %}Zagłębienie na działce{{ main_g }} zatrzyma ok. {{ p.volume_m3|num(10) }} m³ wody{% if p.full_pct != '' %}, czyli {{ pct(p.full_pct) }} wody na pełne nawadnianie w roku suchym{{ fw }}{% if p.rescue_pct != '' and p.rescue_smaller and p.full_pct < 100 %} i {{ pct(p.rescue_pct) }} na podlewanie ratunkowe{% endif %}{% endif %}.
{% if p.shallow %} Jest jednak płytkie (średnio ok. {{ p.mean_depth_m|num(0.1) }} m) i rozległe — latem duża część wody wyparuje, więc staw warto pogłębić na mniejszej powierzchni.{% endif %}
{% if p.sealing == 'natural' %} Gleba ciężka trzyma wodę, więc staw nie wymaga folii.{% elif p.sealing == 'liner' %} Gleba lekka przepuszcza wodę, więc dno trzeba uszczelnić (glina lub geomembrana).{% else %} Nie znamy gleby, więc nie wiadomo, czy dno trzeba uszczelnić.{% endif %}
{% if p.controlled %} Przy tej glebie lub zagrożeniu podtopieniami zrób staw kontrolowany, z odpływem — niekontrolowane rozlewisko po mokrej zimie grozi wymakaniem upraw.{% endif %}
{% endif %}
{% elif m.id == 'weir' %}
{% if m.reason == 'ditch_near' %}Rów lub ciek jest {{ where(p.distance_m) }}, a teren jest płaski: zastawka pozwoli spuścić nadmiar wody wiosną i przytrzymać ją w maju i czerwcu.
{% elif m.reason == 'ditch_near_slope' %}Rów lub ciek jest {{ where(p.distance_m) }}, ale teren opada (średni spadek {{ p.slope_mean_pct|num(0.1) }} %) — zastawka zatrzyma wodę w rowie, lecz nie podniesie wody pod całym polem.
{% elif m.reason == 'flat_wet' %}Teren jest płaski (średni spadek {{ p.slope_mean_pct|num(0.1) }} %) i leży w obszarze zagrożenia podtopieniami — drenaż kontrolowany odprowadzi nadmiar wody wiosną i zatrzyma ją latem.
{% elif m.reason == 'no_hydro' %}Nie mamy danych o rowach i ciekach w okolicy, więc nie wiemy, czy jest gdzie postawić zastawkę.
{% elif m.reason == 'no_ditch_unchecked' %}{% if p.distance_m is defined %}Najbliższy rów lub ciek jest ok. {{ p.distance_m|num(10) }} m od działki{% else %}Na mapie nie ma rowu ani cieku w promieniu {{ p.radius_m|num }} m{% endif %}. {% if p.missing == 'terrain' %}Bez danych o ukształtowaniu terenu{% else %}Bez map zagrożenia podtopieniami{% endif %} nie sprawdziliśmy, czy przyda się drenaż kontrolowany.
{% else %}{% if p.distance_m is defined %}Najbliższy rów lub ciek jest ok. {{ p.distance_m|num(10) }} m od działki{% else %}Na mapie nie ma rowu ani cieku w promieniu {{ p.radius_m|num }} m{% endif %}, a teren nie jest płaski i podmokły — zastawka nie zatrzyma tu wody pod polem.
{% endif %}
{% elif m.id == 'rainwater' %}
{% macro roofs() %}{% if p.on_parcel %}Na działce jest zabudowa{% else %}Zabudowa jest {{ where(p.distance_m) }}{% endif %}{% endmacro %}
{% if m.reason == 'no_landcover' %}Nie mamy mapy zabudowy wokół działki, więc nie wiemy, czy są dachy, z których można zbierać deszczówkę.
{% elif m.reason == 'no_roofs' %}W promieniu {{ p.max_distance_m|num }} m od działki nie ma zabudowy{% if p.distance_m is defined %} (najbliższa ok. {{ p.distance_m|num(10) }} m){% endif %}, więc nie ma dachów do zbierania deszczówki.
{% elif m.reason == 'too_small' %}{{ roofs() }}, ale w roku suchym trzeba ok. {{ p.need_m3|num(10) }} m³ wody{{ fw }} — deszczówka z dachów nie wystarczy jako główne źródło (za mała skala). Przyda się do oprysków i pojenia.
{% elif m.reason == 'small_need' %}{{ roofs() }}, a w roku suchym trzeba tylko ok. {{ p.need_m3|num(10) }} m³ wody{{ fw }} — zbiornik na deszczówkę z dachów może pokryć część tych potrzeb, jeśli dachy są duże.
{% else %}{{ roofs() }} — deszczówka z dachów przyda się do oprysków i pojenia, nie do nawadniania pola.
{% endif %}
{% elif m.id == 'well' %}
{% if m.reason == 'no_plan' %}Za mało danych pogodowych, by policzyć, ile wody trzeba w roku suchym, więc nie oceniamy studni.
{% elif m.reason == 'no_need' %}Nawet w roku suchym deszcz i gleba pokrywały potrzeby uprawy — studnia do nawadniania nie jest potrzebna.
{% elif m.reason == 'retention_covers' %}Zagłębienie na działce{{ main_g }} pomieści tyle wody, ile trzeba w roku suchym{{ fw }} — studnia nie jest potrzebna.
{% else %}{% if p.terrain_unknown %}Nie wiemy, ile wody zatrzyma teren (brak danych o ukształtowaniu terenu); w roku suchym trzeba ok. {{ p.gap_m3|num(10) }} m³ wody{{ fw }} i studnia może ją dostarczyć{% else %}Retencja na działce{{ main_g }} nie pokryje ok. {{ p.gap_m3|num(10) }} m³ wody{{ fw }} w roku suchym; studnia może uzupełnić tę lukę{% endif %}{% if p.gw_depth_m is defined %}. W najbliższej stacji PIG-PIB (ok. {{ p.gw_station_km|num }} km od działki) woda jest ok. {{ p.gw_depth_m|num(0.1) }} m pod ziemią{% else %}. Nie mamy danych o głębokości wody podziemnej w okolicy{% endif %}. To kosztowne rozwiązanie, więc najpierw zatrzymaj wodę na polu.
{% endif %}
{% elif m.id == 'tree_belts' %}
{% macro trees() %}{% if p.share_pct < 0.1 %}W promieniu {{ p.radius_m|num }} m prawie nie ma drzew{% else %}Drzewa zajmują tylko ok. {{ p.share_pct|num(0.1) }} % terenu w promieniu {{ p.radius_m|num }} m{% endif %}{% endmacro %}
{% if m.reason == 'no_landcover' %}Nie mamy mapy pokrycia terenu wokół działki, więc nie wiemy, ile jest zadrzewień w okolicy.
{% elif m.reason == 'runoff_outlet' %}Woda spływa z działki — pas trawy lub zadrzewień tam, gdzie opuszcza pole, zatrzyma spływ i glebę.
{% elif m.reason == 'enough_trees' %}Drzewa zajmują ok. {{ p.share_pct|num(0.1) }} % terenu w promieniu {{ p.radius_m|num }} m — okolica jest już osłonięta od wiatru, a woda nie spływa z pola.
{% else %}{{ trees() }} — teren jest otwarty, wiatr wysusza glebę{% if m.reason == 'open_outlet' %}. Pas zadrzewień lub trawy tam, gdzie woda spływa z działki, zatrzyma spływ i osłoni pole{% else %}. Pas zadrzewień od strony wiatru osłoni pole{% endif %}.
{% endif %}
{% endif %}
{% if p.get('no_need') %} Dane nie pokazują jednak ani niedoboru wody, ani potrzeby nawadniania w roku suchym, więc to działanie nie jest pilne.{% endif %}
{% if p.get('no_irrigation_need') %} Nawet w roku suchym nie trzeba tu nawadniać, więc gromadzenie wody nie jest pilne.{% endif %}
