{#- G9: formal requirement of a retention method (Water Law, see recommendations/retention_methods.py). -#}
{% set p = m.params %}
{% set farm = farm_n|default(1) > 1 %}
{% set main_g = ' głównej' if farm else '' %}
{% set fw = (' ' ~ (farm_n|m3_where)) if farm else '' %}
{% set well_note = ' Limit dotyczy całego poboru w gospodarstwie, a wykonanie studni i instalacji może wymagać osobnej zgody — sprawdź w Wodach Polskich.' %}
{% if m.permit == 'notification' %}Staw do {{ p.max_area_m2|num }} m² i {{ p.max_depth_m|num }} m głębokości, napełniany tylko wodą z deszczu, roztopów lub gruntową: wystarczy zgłoszenie wodnoprawne w Wodach Polskich (Prawo wodne, art. 394 ust. 1 pkt 9).{% if p.outside_parcel %} Część zagłębienia leży poza działką, a zgłoszenie obejmuje staw na własnym gruncie — najpierw ustal to z sąsiadem i Wodami Polskimi.{% endif %}
{% elif m.permit == 'permit' and m.id == 'pond' %}{% if p.area_over and p.depth_over %}Lustro wody ok. {{ p.area_m2|num(10) }} m² i głębokość ponad {{ p.max_depth_m|num }} m przekraczają{% elif p.area_over %}Lustro wody ok. {{ p.area_m2|num(10) }} m² przekracza{% else %}Głębokość ponad {{ p.max_depth_m|num }} m przekracza{% endif %} próg zgłoszenia ({{ p.max_area_m2|num }} m², {{ p.max_depth_m|num }} m) — potrzebne pozwolenie wodnoprawne (Prawo wodne, art. 394 ust. 1 pkt 9). Mniejszy staw (do {{ p.max_area_m2|num }} m² i {{ p.max_depth_m|num }} m) wymaga tylko zgłoszenia.
{% elif m.permit == 'permit' %}Woda ze studni na nawadnianie w roku suchym (ok. {{ p.gap_m3|num(10) }} m³{{ fw }}) to średnio ok. {{ p.per_day_m3|num(0.1) }} m³ na dobę w roku{% if p.per_day_rescue_m3 != '' %}, a samo podlewanie ratunkowe — ok. {{ p.per_day_rescue_m3|num(0.1) }} m³{% endif %}: więcej niż {{ p.max_m3_day|num }} m³ zwykłego korzystania z wód, więc pobór wymaga pozwolenia wodnoprawnego (Prawo wodne, art. 33 ust. 4 pkt 1).
{% elif m.permit == 'permit_full_only' %}{% if p.gap_rescue_m3 %}Samo podlewanie ratunkowe (ok. {{ p.gap_rescue_m3|num(10) }} m³ ze studni, średnio ok. {{ p.per_day_rescue_m3|num(0.1) }} m³ na dobę w roku) mieści się w {{ p.max_m3_day|num }} m³ zwykłego korzystania z wód{% else %}Wodę na podlewanie ratunkowe da zagłębienie, więc ze studni nie trzeba jej pobierać{% endif %}; pełne nawadnianie (średnio ok. {{ p.per_day_m3|num(0.1) }} m³ na dobę) wymaga pozwolenia wodnoprawnego (Prawo wodne, art. 33 ust. 4 pkt 1).{{ well_note }}
{% elif m.permit == 'ordinary_use' %}Sam pobór ze studni, średnio ok. {{ p.per_day_m3|num(0.1) }} m³ na dobę w roku, mieści się w {{ p.max_m3_day|num }} m³ zwykłego korzystania z wód (Prawo wodne, art. 33 ust. 4 pkt 1).{{ well_note }}
{% elif m.permit == 'check' %}Uzgodnij z zarządcą rowu (spółka wodna lub Wody Polskie) i sprawdź w Wodach Polskich, czy wystarczy zgłoszenie wodnoprawne, czy potrzebne jest pozwolenie.
{% elif m.permit == 'check_drainage' %}Jeśli pole jest zmeliorowane, uzgodnij to ze spółką wodną; w Wodach Polskich sprawdź, czy przebudowa drenażu wymaga zgłoszenia lub pozwolenia wodnoprawnego.
{% endif %}
