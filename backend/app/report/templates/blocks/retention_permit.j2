{#- G9: formal requirement of a retention method (Water Law, see recommendations/retention_methods.py). -#}
{% set p = m.params %}
{% if m.permit == 'notification' %}Staw do {{ p.max_area_m2|num }} m² i {{ p.max_depth_m|num }} m głębokości, napełniany tylko wodą z deszczu, roztopów lub gruntową: wystarczy zgłoszenie wodnoprawne w Wodach Polskich (Prawo wodne, art. 394 ust. 1 pkt 9).
{% elif m.permit == 'permit' and m.id == 'pond' %}Lustro wody ok. {{ p.area_m2|num(10) }} m²{% if p.depth_m > p.max_depth_m %} lub głębokość ponad {{ p.max_depth_m|num }} m{% endif %} przekracza próg zgłoszenia ({{ p.max_area_m2|num }} m², {{ p.max_depth_m|num }} m) — potrzebne pozwolenie wodnoprawne (Prawo wodne, art. 394 ust. 1 pkt 9).
{% elif m.permit == 'permit' %}Woda ze studni na nawadnianie w roku suchym (ok. {{ p.gap_m3|num(10) }} m³) to średnio ok. {{ p.per_day_m3|num(0.1) }} m³ na dobę w roku{% if p.per_day_rescue_m3 != '' %}, a samo podlewanie ratunkowe — ok. {{ p.per_day_rescue_m3|num(0.1) }} m³{% endif %}: więcej niż {{ p.max_m3_day|num }} m³ zwykłego korzystania z wód, więc pobór wymaga pozwolenia wodnoprawnego (Prawo wodne, art. 33 ust. 4 pkt 1).
{% elif m.permit == 'permit_full_only' %}Samo podlewanie ratunkowe {% if p.gap_rescue_m3 %}(ok. {{ p.gap_rescue_m3|num(10) }} m³ ze studni) to średnio ok. {{ p.per_day_rescue_m3|num(0.1) }} m³ na dobę w roku{% else %}pokryje woda z zagłębienia{% endif %} — w limicie {{ p.max_m3_day|num }} m³ zwykłego korzystania z wód; pełne nawadnianie (ok. {{ p.per_day_m3|num(0.1) }} m³ na dobę) wymaga pozwolenia wodnoprawnego (Prawo wodne, art. 33 ust. 4 pkt 1).
{% elif m.permit == 'ordinary_use' %}Pobór ze studni średnio ok. {{ p.per_day_m3|num(0.1) }} m³ na dobę w roku mieści się w {{ p.max_m3_day|num }} m³ zwykłego korzystania z wód — bez pozwolenia wodnoprawnego (Prawo wodne, art. 33 ust. 4 pkt 1).
{% elif m.permit == 'check' %}Uzgodnij z zarządcą rowu (spółka wodna lub Wody Polskie) i sprawdź w Wodach Polskich, czy wystarczy zgłoszenie wodnoprawne, czy potrzebne jest pozwolenie.
{% endif %}
