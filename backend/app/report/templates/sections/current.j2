{#- Section 2: water situation on analysis_date. -#}
{% macro diff_vs_typical(value, typical, pct) -%}
{#- The mm difference only when the percentile also says wetter/drier than usual, so both agree. -#}
{% if pct is not none and (pct < 30 or pct > 70) and typical is not none and ((value|round(0)) - (typical|round(0)))|abs >= 1 %}{% set d = (value|round(0)) - (typical|round(0)) %} ({% if d >= 1 %}o {{ d|num }} mm więcej niż zwykle{% else %}o {{ (-d)|num }} mm mniej niż zwykle{% endif %}){% endif %}
{%- endmacro %}
{% macro sat_condition(c, low_ndvi) -%}
{% set now_v = c.sat.get('ndvi_current') %}{% set med = c.sat.get('ndvi_history_median') %}
{% if now_v is not none and med %}{% set diff = ((now_v - med) / med * 100)|round(0) %}{% if low_ndvi and diff <= -1 %}słabsza niż zwykle o ok. {{ (-diff)|num }}%{% elif low_ndvi %}słabsza niż zwykle{% elif diff <= -5 %}nieco słabsza niż zwykle (o ok. {{ (-diff)|num }}%){% else %}dobra — {% if diff >= 5 %}lepsza niż zwykle o ok. {{ diff|num }}%{% else %}podobna jak zwykle{% endif %}{% endif %}{% elif low_ndvi %}słabsza niż zwykle{% else %}dobra — podobna jak zwykle{% endif %}
{%- endmacro %}
