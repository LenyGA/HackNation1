<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GeoSatel — raport dla działki {{ r.parcel.id }} ({{ r.analysis_date|date_pl }})</title>
<style>{{ css|safe }}</style>
</head>
<body>
<span class="report-id">{{ r.id }}</span>
<div class="brand"><img src="{{ logo_uri }}" alt="GeoSatel"></div>
<h1>Raport o wodzie na działce</h1>
<div class="meta">
  <span>Działka: <b>{{ r.parcel.id }}</b></span>
  {% if r.parcel.commune %}<span>{{ r.parcel.commune|with_prefix('gmina')|capitalize_first }}{% if r.parcel.county %}, {{ r.parcel.county|with_prefix('powiat') }}{% endif %}{% if r.parcel.voivodeship %}, {{ r.parcel.voivodeship|with_prefix('woj.') }}{% endif %}</span>{% endif %}
  <span>Powierzchnia: {{ r.parcel.area_ha|num(0.01) }} ha</span>
  <span>Uprawa: {{ r.crop.name_pl }}</span>
  <span>Data analizy: <b>{{ r.analysis_date|date_pl }}</b></span>
  <span>Raport utworzono: {{ r.created_at|date_pl }}</span>
  {% if r.farm %}<span>Gospodarstwo: <b>{{ r.farm.count }} {{ r.farm.count|plural('działka', 'działki', 'działek') }}, {{ r.farm.total_area_ha|num(0.01) }} ha</b></span>{% endif %}
</div>

{% if r.farm %}
<div class="farm">
  {% for t in r.farm.text_pl %}<p class="small">{{ t }}</p>{% endfor %}
  <p class="small">Pozostałe działki: {% for p in r.farm.parcels %}{{ p.id }} ({{ p.area_ha|num(0.01) }} ha{% if p.distance_m is not none %}, {% if p.distance_m == 0 %}przylega do głównej{% else %}ok. {{ p.distance_m|num }} m od głównej{% endif %}{% endif %}){% if not loop.last %}; {% endif %}{% endfor %}.</p>
</div>
{% endif %}

<div class="headline level-{{ r.headline.level }}">
  <div class="label">{{ r.headline.label_pl }}</div>
  <div>{{ r.headline.sentence_pl }}</div>
  <div class="confidence">{{ r.headline.confidence_pl }}</div>
</div>

{% if r.summary_tiles %}
<div class="tiles">
{% for t in r.summary_tiles %}
  <div class="tile {{ t.status }}">
    <div class="tl">{{ t.label_pl }}</div>
    <div class="tv">{{ t.value_pl }}</div>
    {% if t.gauge %}<div class="gauge"><div class="fill" style="width: {{ (100 * t.gauge.value / t.gauge.max)|round(1) if t.gauge.max else 0 }}%"></div>{% if t.gauge.threshold is not none and t.gauge.max %}<div class="thr" style="left: {{ (100 * t.gauge.threshold / t.gauge.max)|round(1) }}%"></div>{% endif %}</div>{% if t.gauge.threshold is not none %}<div class="gthr">próg stresu: {{ t.gauge.threshold|num }} {{ t.gauge.unit }}</div>{% endif %}{% endif %}
  </div>
{% endfor %}
</div>
{% endif %}

{% for s in r.sections %}
<section class="section-{{ s.id }}{% if s.id == 'sources' %} sources{% elif s.id == 'limitations' %} limits{% endif %}">
  <h2>{{ s.number }}. {{ s.title_pl }}</h2>
  {% for p in s.paragraphs_pl %}<p{% if p in r.missing_data_pl %} class="missing-line"{% endif %}>{{ p }}</p>{% endfor %}

  {% if s.id == 'current' and charts.season %}
  {% set sc = charts.season_chart %}
  <div class="chart"><div class="cap">Deszcz i potrzeby wodne uprawy od {{ sc.start|date_dmy }} do {{ sc.end|date_dmy }} (narastająco)</div>{{ charts.season|safe }}<div class="src">Granatowa linia: deszcz {{ 'w wybranym okresie' if r.water_daily else 'w tym sezonie' }} ({% set v = sc.points[-1].precip_mm %}{{ (v|num ~ ' mm') if v is not none else 'brak danych' }}); pomarańczowa: potrzeby wodne uprawy ({% set v = sc.points[-1].crop_need_mm %}{{ (v|num ~ ' mm') if v is not none else 'brak danych' }}){% if sc.years > 0 %}; przerywana: zwykle (środek z {{ sc.years }} lat, {% set v = sc.points[-1].precip_hist_median_mm %}{{ (v|num ~ ' mm') if v is not none else 'brak danych' }}); pas: od najsuchszego do najmokrzejszego roku{% endif %}.</div><div class="src">Źródło: {{ sc.source }}</div></div>
  {% endif %}

  {% if s.id == 'current' and r.satellite and charts.satellite %}
  <div class="chart"><div class="cap">Kondycja roślin z satelity: na dzień {{ r.analysis_date|date_dmy }} i w tych samych tygodniach w poprzednich latach</div>{{ charts.satellite|safe }}<div class="src">Skala: 0 — brak zieleni, 1 — bujna zieleń; pas: zakres z poprzednich lat; pomarańczowe: zdjęcia z sezonu analizy (DD.MM).</div><p>{{ r.satellite.text_pl }}</p><div class="src">Źródło: {{ r.satellite.source }}</div></div>
  {% endif %}

  {% if s.id == 'vulnerability' and r.months %}
  <table>
    <thead><tr><th>Miesiąc</th><th>Lata z niedoborem wody</th><th>Lata z poważnym niedoborem</th><th>Średnio dni stresu</th><th>Częstość</th><th>Uwagi</th></tr></thead>
    <tbody>
    {% for m in r.months %}
      <tr class="{% if m.risk %}risk{% endif %}">
        <td class="{% if m.critical %}critical{% endif %}">{{ m.month_pl }}</td>
        <td class="num">{{ m.deficit_years }} z {{ m.years_with_data }}</td>
        <td class="num">{{ m.severe_years }} z {{ m.years_with_data }}</td>
        <td class="num">{% if m.mean_stress_days is not none %}{{ m.mean_stress_days|num }}{% else %}–{% endif %}</td>
        <td class="num">{% if m.frequency_pct is not none %}{{ m.frequency_pct|num }} %{% else %}brak danych{% endif %}</td>
        <td>{% if m.critical %}okres, gdy uprawa najbardziej potrzebuje wody{% endif %}{% if m.risk and m.critical %}; {% endif %}{% if m.risk %}częsty niedobór{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if s.id == 'vulnerability' and r.stress_heatmap %}
  {% set hm = r.stress_heatmap %}
  <div class="chart"><div class="cap">Dni stresu wodnego uprawy w kolejnych latach i miesiącach</div>
  <table class="heat">
    <thead><tr><th>Rok</th>{% for m in hm.months_pl %}<th>{{ m[:3] }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for row in hm.rows %}
      <tr><td>{{ row.year }}</td>{% for d in row.stress_days %}{% set n = row.season_days[loop.index0] %}{% set share = (d / n) if (d is not none and n) else none %}<td style="background: {% if share is none %}#f4f4f4{% elif share <= 0 %}#f0fdf4{% elif share < 0.2 %}#fef9c3{% elif share < 0.334 %}#fde68a{% elif share < 0.5 %}#fdba74{% elif share < 0.75 %}#f87171{% else %}#b91c1c; color: #fff{% endif %}">{% if d is not none %}{{ d }}{% else %}–{% endif %}</td>{% endfor %}</tr>
    {% endfor %}
    </tbody>
  </table>
  <div class="src">Kolor: udział dni ze stresem w miesiącu — od zielonego (bez stresu) przez żółty (do 1/3 dni) i pomarańczowy (do połowy) do czerwonego (ponad połowa, ciemny: ponad 3/4). Źródło: {{ hm.source }}</div></div>
  {% endif %}

  {% if s.id == 'vulnerability' and r.trends %}
  <h3>Jak zmienia się klimat na działce: {{ r.trends.seasons[0] }}–{{ r.trends.seasons[-1] }} <span class="pill {{ {'critical': 'bad', 'worse': 'warn', 'stable': 'good', 'better': 'good', 'unknown': 'unknown'}[r.trends.level] }}">{{ r.trends.label_pl }}</span></h3>
  {% for p in r.trends.verdict_pl %}<p>{{ p }}</p>{% endfor %}
  <div class="trend-grid">
  {% for m, svg in charts.trends %}
    <div class="chart"><div class="cap">{{ m.label_pl }}</div>{{ svg|safe }}<div class="src">{{ m.summary_pl }}. Pomarańczowe: ostatnie 2 sezony; kreska: średnia.</div></div>
  {% endfor %}
  </div>
  <p class="small">{{ r.trends.uncertainty_pl }} Źródło: {{ r.trends.source }}</p>
  {% endif %}

  {% if s.id == 'causes' and r.groundwater %}
  <p><b>Wody podziemne w okolicy:</b> {{ r.groundwater.sentence_pl }} <span class="small">Źródło: {{ r.groundwater.source }}</span></p>
  {% endif %}

  {% if s.id == 'retention' and r.flood %}
  <p><b>Zagrożenie powodziowe:</b> <span class="pill {{ {'high': 'bad', 'medium': 'warn', 'low': 'warn', 'none': 'good', 'unknown': 'unknown'}[r.flood.level] }}">{{ r.flood.label_pl }}</span> {{ r.flood.sentence_pl }} <span class="small">Źródło: {{ r.flood.source }}</span></p>
  {% endif %}

  {% if s.id == 'retention' and r.profile and charts.profile %}
  <div class="chart"><div class="cap">Przekrój terenu działki wzdłuż spływu wody</div>{{ charts.profile|safe }}<p>{{ r.profile.text_pl }}</p><div class="src">Źródło: {{ r.profile.source }}</div></div>
  {% endif %}

  {% if s.id == 'retention' and r.retention_plan %}
  {% set rp = r.retention_plan %}
  <h3>Jak zatrzymać i zgromadzić wodę na tej działce</h3>
  <div class="cov {{ 'good' if rp.coverage.full_pct is not none and rp.coverage.full_pct >= 100 else 'warn' if rp.coverage.status == 'ok' else 'unknown' }}"><b>Ile wody da retencja na działce?</b> {{ rp.coverage.text_pl }} <span class="small">Źródło: {{ rp.coverage.source|source_short }}</span></div>
  <table class="compact methods">
    <thead><tr><th>Sposób i ocena</th><th>Dlaczego (dane tej działki) i formalności</th></tr></thead>
    <tbody>
    {% for m in rp.methods %}
      <tr><td><b>{{ m.label_pl }}</b><br><span class="pill {{ method_pill[m.status] }}">{{ m.status_pl }}</span></td><td>{{ m.reason_pl }}{% if m.legal_pl %} <i>Formalności:</i> {{ m.legal_pl }}{% endif %}{% if m.evidence %} <span class="small">Źródło: {{ m.evidence|map(attribute='source')|map('source_short')|unique|join('; ') }}.</span>{% endif %}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  <p class="small">Ocena wynika z reguł sprawdzających dane tej działki; „brak danych” oznacza, że źródło nie odpowiedziało, a nie, że sposób się nie nadaje. Podstawa prawna: {{ rp.legal_basis_pl }}.</p>
  {% endif %}

  {% if s.id == 'irrigation' and r.water_plan %}
  {% set wp = r.water_plan %}
  <h3>Plan wody na sezon: rok typowy i rok suchy</h3>
  {% if charts.water_plan %}<div class="chart">{{ charts.water_plan|safe }}</div>{% endif %}
  {% for p in wp.text_pl %}<p>{{ p }}</p>{% endfor %}
  <table class="compact">
    <thead><tr><th>Miesiąc</th><th>Potrzeby uprawy</th><th>Deszcz</th><th>Brak wody: rok typowy</th><th>Rok suchy (1 na 5 lat)</th><th>Bardzo suchy (1 na 10)</th><th>Rok suchy, m³/ha</th></tr></thead>
    <tbody>
    {% for m in wp.months %}
      <tr><td class="{% if m.critical %}critical{% endif %}">{{ m.month_pl }}</td>{% for v in [m.crop_need_mm, m.precip_mm, m.deficit_median_mm, m.deficit_p80_mm, m.deficit_p90_mm] %}<td class="num">{% if v is not none %}{{ v|num }} mm{% else %}–{% endif %}</td>{% endfor %}<td class="num">{% if m.deficit_p80_m3_ha is not none %}{{ m.deficit_p80_m3_ha|num(10) }}{% else %}–{% endif %}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  <p class="small">Rok typowy, suchy i bardzo suchy wyznaczone z {{ wp.years }} poprzednich lat (metoda FAO-56). Źródło: {{ wp.source }}</p>
  {% endif %}

  {% if s.id == 'irrigation' and r.irrigation_economics %}
  {% set ie = r.irrigation_economics %}
  {% set verdict_pill = {'profitable': 'good', 'borderline': 'warn', 'unprofitable': 'bad', 'unknown': 'unknown'} %}
  <h3>Jaka instalacja i czy nawadnianie się opłaca</h3>
  <p><b>{{ ie.technology_pl }}.</b> {% for t in ie.technology_text_pl %}{{ t }} {% endfor %}</p>
  <div class="cov {{ verdict_pill[ie.verdict] }}"><span class="pill {{ verdict_pill[ie.verdict] }}">{{ ie.verdict_pl }}</span> {% for t in ie.text_pl %}{{ t }} {% endfor %}</div>
  {% if ie.status == 'ok' or ie.status == 'no_price' %}
  <table class="compact">
    <thead><tr><th>Na 1 ha rocznie</th><th>Od</th><th>Do</th></tr></thead>
    <tbody>
    {% if ie.benefit_zl_ha_low is not none %}<tr><td>Wartość plonu, który zabierała susza</td><td class="num">{{ ie.benefit_zl_ha_low|num(50) }} zł</td><td class="num">{{ ie.benefit_zl_ha_high|num(50) }} zł</td></tr>{% endif %}
    <tr><td>Koszt nawadniania (instalacja, ujęcie wody, pompowanie)</td><td class="num">{{ ie.cost_zl_ha_low|num(50) }} zł</td><td class="num">{{ ie.cost_zl_ha_high|num(50) }} zł</td></tr>
    </tbody>
  </table>
  {% endif %}
  <div class="details"><span class="t">Założenia (w wersji na stronie można je zmienić).</span> {% for a in ie.assumptions_pl %}{{ a }} {% endfor %}{% set as = ie.assumptions %}{% if as.yield_t_ha %}Plon odniesienia: {{ as.yield_t_ha|num(0.1) }} t/ha{% if as.price_zl_t_low is not none %}, cena {{ as.price_zl_t_low|num(10) }}–{{ as.price_zl_t_high|num(10) }} zł/t{% endif %}{% if as.ky %}, Ky {{ as.ky|num(0.01) }}{% endif %}. {% endif %}{% if ie.technology != 'none' %}{% if as.capex_zl_ha_low is not none %}Instalacja {{ as.capex_zl_ha_low|num(100) }}–{{ as.capex_zl_ha_high|num(100) }} zł/ha na {{ as.lifetime_years }} lat; {% endif %}ujęcie wody {{ as.water_source_zl_low|num(1000) }}–{{ as.water_source_zl_high|num(1000) }} zł na {{ as.water_source_lifetime_years }} lat; pompowanie {{ as.operating_zl_m3_low|num(0.1) }}–{{ as.operating_zl_m3_high|num(0.1) }} zł/m³; sprawność {{ ie.efficiency_pct }} %.{% endif %}</div>
  <p class="small">Źródło: {{ ie.source }}</p>
  {% endif %}

  {% if s.id == 'irrigation' and r.simulation and show_simulation %}
  {% set sim = r.simulation %}
  <h3>Co dalej? Porównanie strategii na 1–5 lat</h3>
  {% for p in sim.text_pl %}<p>{{ p }}</p>{% endfor %}
  <table class="compact">
    <thead><tr><th>Strategia</th>{% for y in sim.strategies[0].years if y.year_ahead in (1, 3, 5) %}<th>za {{ y.year_ahead }} {{ y.year_ahead|plural('rok', 'lata', 'lat') }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for st in sim.strategies %}
      <tr><td><b>{{ st.label_pl }}</b><br><span class="small">{{ st.description_pl }}</span></td>{% for y in st.years if y.year_ahead in (1, 3, 5) %}<td class="num">{% if y.stress_days_median is not none %}{{ y.stress_days_median|num }} dni stresu{% endif %}{% if y.stress_days_p80 is not none %}<br><span class="small">rok suchy: {{ y.stress_days_p80|num }}</span>{% endif %}{% if y.irrigation_mm_p80 %}<br><span class="small">woda: {{ y.irrigation_mm_p80|num }} mm</span>{% endif %}</td>{% endfor %}</tr>
    {% endfor %}
    </tbody>
  </table>
  <div class="details"><span class="t">Założenia symulacji.</span> {% for a in sim.assumptions_pl %}{{ a }} {% endfor %}</div>
  {% endif %}

  {% if s.id == 'retention' and (r.map.features or s.recommendation_numbers) %}
  <div class="map">
    {{ map_svg|safe }}
    <div class="legend">
      <div><span style="background:#ffffff;border:1.4pt solid #000"></span>Granica działki</div>
      {% for kind, text in r.map.legend_pl.items() %}<div><span style="background:{{ legend_colors[kind] }}"></span>{{ text }}</div>{% endfor %}
      <div><span style="background:#fff;border-radius:50%"></span>Numer zalecenia</div>
      {% if basemap == 'ok' %}<div class="small">Podkład: ortofotomapa © GUGiK (Geoportal.gov.pl), stan obecny.</div>{% elif basemap == 'failed' %}<div class="small">Bez podkładu ortofotomapy — usługa Geoportalu nie odpowiedziała na czas.</div>{% endif %}
    </div>
  </div>
  {% endif %}

  {% for n in s.recommendation_numbers %}
  {% set rec = recs[n] %}
  <div class="rec {{ rec.category.value }}">
    <h3>{{ rec.number }}. {{ rec.title_pl }}</h3>
    {% if rec.category.value != 'irrigation' %}<p>{{ rec.text_pl }}</p>{% endif %}
    <ul class="why">
      {% for e in rec.evidence %}<li>{{ e.label_pl }}: <b>{{ e.value_pl }}</b>{% if e.period %} ({{ e.period.start|date_pl }}{% if e.period.end != e.period.start %} – {{ e.period.end|date_pl }}{% endif %}){% endif %}; źródło: {{ e.source|source_short }}; pewność {{ confidence_pl[e.uncertainty.level.value] }}</li>{% endfor %}
    </ul>
  </div>
  {% endfor %}

  {% if s.details_pl %}
  <div class="details"><span class="t">Szczegóły dla zainteresowanych.</span> {% for d in s.details_pl %}{{ d }} {% endfor %}</div>
  {% endif %}
</section>
{% endfor %}

<p class="small">Raport wygenerowała aplikacja GeoSatel {{ r.version }} (HackNation 2026) wyłącznie z publicznych danych, bez modeli AI. Wynik jest obliczany na żywo dla tej działki i daty. Link do raportu: /raport/{{ r.id }}</p>
</body>
</html>
